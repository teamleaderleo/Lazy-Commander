{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": ["now", "soon", "keep"],
      "type": "string"
    },
    "reason": {
      "enum": ["stable-boundary", "checkpoint-first", "active-phase"],
      "type": "string"
    }
  },
  "required": ["decision", "reason"],
  "type": "object"
}
